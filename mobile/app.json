{
  "expo": {
    "name": "GMS Mobile",
    "slug": "gms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gms.mobile"
    },
    "android": {
      "package": "com.gms.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GMS Mobile to access your camera for QR code scanning."
        }
      ],
      [
        "expo-barcode-scanner",
        {
          "cameraPermission": "Allow GMS Mobile to access your camera for QR code scanning."
        }
      ]
    ]
  }
}