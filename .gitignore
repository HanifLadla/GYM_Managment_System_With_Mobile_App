# ==========================================
# GMS - Git Ignore
# ==========================================

# --------------------
# Node dependencies
# --------------------
node_modules/
**/node_modules/

# --------------------
# Environment / Secrets
# --------------------
.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example

# --------------------
# Frontend / Production Builds
# --------------------
frontend/dist/
frontend/build/
backend/dist/

# --------------------
# Logs
# --------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

logs/
*.pid
*.pid.lock

# --------------------
# Cache
# --------------------
.cache/
.vite/
**/.vite/
.eslintcache
.npm/

# --------------------
# Testing
# --------------------
coverage/
.nyc_output/

# --------------------
# IDE / Editor
# --------------------
.vscode/
.idea/
*.swp
*.swo

# --------------------
# Operating System
# --------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------
# Temporary Files
# --------------------
*.tmp
*.temp
*.bak
temp/
tmp/

# --------------------
# Archives / Deployment ZIPs
# --------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# --------------------
# Prisma Local Databases
# --------------------
*.db
*.db-journal

# --------------------
# Runtime Uploaded Files
# --------------------
backend/uploads/

# --------------------
# Old / Duplicate Project Copy
# --------------------
publisher folder/